SECRET_KEY=change-me-in-.env-never-commit-the-real-value
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
# Origenes permitidos por CORS para llamadas directas desde el navegador (talent-pipeline-tracker).
# Backoffice no lo necesita: sus llamadas de auth pasan por sus propias route handlers server-side.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# API key de Resend (https://resend.com/api-keys). Nunca hardcodeada, nunca commiteada.
RESEND_API_KEY=re_change-me
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
RESEND_FROM_EMAIL=onboarding@resend.dev
FRONTEND_URL=http://localhost:3001

# Cadena de conexión Postgres de Supabase (inventario). Si la contraseña tiene
# caracteres especiales (@ % # etc.), deben ir URL-encoded o el DSN no parsea.
DATABASE_URL=postgresql://user:password@host:6543/postgres

# Catálogo de eventos de telemetría (allowlists por evento). Opcional: por defecto
# se lee `docs/telemetry/event-schemas.json` relativo a la raíz del monorepo.
# En Docker se monta en /docs/telemetry (ver docker-compose.yml).
# TELEMETRY_SCHEMAS_PATH=../../docs/telemetry/event-schemas.json
