# Variables de entorno para docker-compose.yml (raíz del monorepo).
# Copia este archivo a .env y rellena los valores reales. Nunca commitees .env.

# --- services/api ---
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
RESEND_API_KEY=
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
RESEND_FROM_EMAIL=onboarding@resend.dev
FRONTEND_URL=http://localhost:3001
DATABASE_URL=

# --- Cola de tareas (Celery + Redis) ---
# Broker y result backend; la misma URL para API, worker y Flower.
# En local fuera de Docker: redis://localhost:6379/0
REDIS_URL=redis://redis:6379/0
# Timeout blando por tarea, en segundos (el duro es este + 60).
TASK_SOFT_TIME_LIMIT=540

# --- RAG / base de conocimiento (Hito 7) ---
# Qdrant: en Docker el servicio `qdrant`; en local fuera de Docker: http://localhost:6333
QDRANT_URL=http://qdrant:6333
# Modelos proporcionados por 4Geeks (API compatible con OpenAI). El modelo de
# embeddings y el de generación DEBEN ser distintos.
LLM_BASE_URL=
LLM_API_KEY=
EMBEDDING_MODEL=
GENERATION_MODEL=
# Umbral mínimo de similitud coseno (ver docs/rag/rag-design.md)
RAG_MIN_SCORE=0.30

# --- MCP Server (mcps/nexova-tools) + OAuth con Logto ---
# URL pública del endpoint MCP; es también el "API identifier" del recurso en
# Logto (= `aud` del token). En Codespaces: https://<codespace>-8100.app.github.dev/mcp
MCP_RESOURCE_URL=
# Issuer OIDC de Logto: https://<tenant>.logto.app/oidc
MCP_OAUTH_ISSUER=
# Cuenta de servicio con la que el MCP llama a la API (un usuario normal de /users).
NEXOVA_API_EMAIL=
NEXOVA_API_PASSWORD=
# Agente LangGraph como cliente MCP (app M2M de Logto con incidents:read e inventory:read).
# En local fuera de Docker: AGENT_MCP_URL=http://localhost:8100/mcp
AGENT_MCP_URL=http://mcp:8100/mcp
# Token endpoint de Logto: https://<tenant>.logto.app/oidc/token
AGENT_MCP_TOKEN_URL=
AGENT_MCP_CLIENT_ID=
AGENT_MCP_CLIENT_SECRET=

# --- uis (backoffice) ---
# Comunicación entre contenedores: nombre de servicio Docker, nunca localhost.
BACKEND_API_URL=http://api:8000
# Telemetría: la llama el NAVEGADOR (no el contenedor), así que va con la URL
# pública de la API, no con el nombre de servicio `api`.
NEXT_PUBLIC_TELEMETRY_ENDPOINT=http://localhost:8000/telemetry/events
