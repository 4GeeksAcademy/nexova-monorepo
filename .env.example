# Variables de entorno para docker-compose.yml (raíz del monorepo).
# Copia este archivo a .env y rellena los valores reales. Nunca commitees .env.

# --- services/api ---
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
# Swagger/ReDoc/OpenAPI públicos: false en cualquier entorno expuesto (docker-compose.dev.yml lo activa).
ENABLE_API_DOCS=false
# Quién puede registrar cada decisión de aprobación de RFP: JSON {"Nombre del responsable": "email"}.
# Vacío = solo un admin puede decidir. Ej.: {"Roberto Díaz": "roberto.diaz@nexova-solutions.com"}
RFP_APPROVERS=
# Límite de intentos en /auth (por defecto 5 fallos / 15 min).
AUTH_MAX_FAILED_LOGINS=5
AUTH_LOCKOUT_SECONDS=900
RESEND_API_KEY=
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
RESEND_FROM_EMAIL=onboarding@resend.dev
FRONTEND_URL=http://localhost:3001
DATABASE_URL=

# --- Cola de tareas (Celery + Redis) ---
# Contraseña de Redis (obligatoria). docker-compose construye con ella la REDIS_URL
# de API, worker y Flower. Genera una con: openssl rand -hex 32
REDIS_PASSWORD=
# Solo para procesos fuera de Docker (con docker-compose.dev.yml, que publica Redis en 127.0.0.1):
# REDIS_URL=redis://:<REDIS_PASSWORD>@localhost:6379/0
# Flower (perfil dev): usuario:contraseña
FLOWER_BASIC_AUTH=
# Timeout blando por tarea, en segundos (el duro es este + 60).
TASK_SOFT_TIME_LIMIT=540

# --- RAG / base de conocimiento (Hito 7) ---
# Qdrant: en Docker el servicio `qdrant`; en local fuera de Docker: http://localhost:6333
QDRANT_URL=http://qdrant:6333
# API key de Qdrant (obligatoria en docker-compose): openssl rand -hex 32
QDRANT_API_KEY=
# Modelos proporcionados por 4Geeks (API compatible con OpenAI). El modelo de
# embeddings y el de generación DEBEN ser distintos.
LLM_BASE_URL=
LLM_API_KEY=
EMBEDDING_MODEL=
GENERATION_MODEL=
# Umbral mínimo de similitud coseno (ver docs/rag/rag-design.md)
RAG_MIN_SCORE=0.30

# --- MCP Server (mcps/nexova-tools) + OAuth con Logto ---
# URL pública del endpoint MCP; es también el "API identifier" del recurso en
# Logto (= `aud` del token). En Codespaces: https://<codespace>-8100.app.github.dev/mcp
MCP_RESOURCE_URL=
# Issuer OIDC de Logto: https://<tenant>.logto.app/oidc
MCP_OAUTH_ISSUER=
# Cuenta de servicio con la que el MCP llama a la API. Regístrala en /users y
# promuévela a manager (las rutas de incidentes son solo personal interno):
#   uv run --project services/api python scripts/set_user_role.py <email> manager
NEXOVA_API_EMAIL=
NEXOVA_API_PASSWORD=
# Agente LangGraph como cliente MCP (app M2M de Logto con incidents:read e inventory:read).
# En local fuera de Docker: AGENT_MCP_URL=http://localhost:8100/mcp
AGENT_MCP_URL=http://mcp:8100/mcp
# Token endpoint de Logto: https://<tenant>.logto.app/oidc/token
AGENT_MCP_TOKEN_URL=
AGENT_MCP_CLIENT_ID=
AGENT_MCP_CLIENT_SECRET=

# Orígenes de navegador permitidos por CORS en el MCP (nunca *).
MCP_ALLOWED_ORIGINS=https://www.mcpplayground.tech

# --- Exposición de puertos en el host (por defecto solo 127.0.0.1) ---
# API_BIND=127.0.0.1
# MCP_BIND=127.0.0.1
# UIS_BIND=127.0.0.1

# --- uis (backoffice) ---
# production (next build + start) | development (next dev; lo fija docker-compose.dev.yml)
UIS_MODE=production
# Comunicación entre contenedores: nombre de servicio Docker, nunca localhost.
BACKEND_API_URL=http://api:8000
# Telemetría: la llama el NAVEGADOR (no el contenedor), así que va con la URL
# pública de la API, no con el nombre de servicio `api`.
NEXT_PUBLIC_TELEMETRY_ENDPOINT=http://localhost:8000/telemetry/events
